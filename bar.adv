# foo
def fibo: (Int->Int) [
  1 -
  dup 0 <= if [
    pop
    1
  ] else [
    dup fibo swap
    1 - fibo
    + 
  ]
]

def loopfibo: (Int->Int) [
  dup 1 <= if [
    pop
    1
  ] else [
    1 >$a
    1 >$b
    loop [
      dup 1 <= if break
      $a $b + >$c
      $b >$a
      $c >$b
      1 -
    ]
    pop
    $b
  ]
]

def main [
  15
  dup fibo
  print pop
  dup loopfibo
  print pop
]
