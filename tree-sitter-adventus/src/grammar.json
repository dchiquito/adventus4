{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "adventus",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "def"
      }
    },
    "def": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "def"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "manual_signature"
                },
                {
                  "type": "SYMBOL",
                  "name": "doc_signature"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "positive_int": {
      "type": "PATTERN",
      "value": "[1-9][0-9_]*"
    },
    "negative_int": {
      "type": "PATTERN",
      "value": "-[1-9][0-9_]*"
    },
    "int": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "positive_int"
        },
        {
          "type": "SYMBOL",
          "name": "negative_int"
        }
      ]
    },
    "grouping": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "expression"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "dup": {
      "type": "STRING",
      "value": "dup"
    },
    "swap": {
      "type": "STRING",
      "value": "swap"
    },
    "add": {
      "type": "STRING",
      "value": "+"
    },
    "sub": {
      "type": "STRING",
      "value": "-"
    },
    "mul": {
      "type": "STRING",
      "value": "*"
    },
    "div": {
      "type": "STRING",
      "value": "/"
    },
    "eq": {
      "type": "STRING",
      "value": "=="
    },
    "ne": {
      "type": "STRING",
      "value": "!="
    },
    "gt": {
      "type": "STRING",
      "value": ">"
    },
    "lt": {
      "type": "STRING",
      "value": "<"
    },
    "gte": {
      "type": "STRING",
      "value": ">="
    },
    "lte": {
      "type": "STRING",
      "value": "<="
    },
    "and": {
      "type": "STRING",
      "value": "and"
    },
    "or": {
      "type": "STRING",
      "value": "or"
    },
    "not": {
      "type": "STRING",
      "value": "not"
    },
    "print": {
      "type": "STRING",
      "value": "print"
    },
    "builtin": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "dup"
        },
        {
          "type": "SYMBOL",
          "name": "swap"
        },
        {
          "type": "SYMBOL",
          "name": "add"
        },
        {
          "type": "SYMBOL",
          "name": "sub"
        },
        {
          "type": "SYMBOL",
          "name": "mul"
        },
        {
          "type": "SYMBOL",
          "name": "div"
        },
        {
          "type": "SYMBOL",
          "name": "eq"
        },
        {
          "type": "SYMBOL",
          "name": "ne"
        },
        {
          "type": "SYMBOL",
          "name": "gt"
        },
        {
          "type": "SYMBOL",
          "name": "lt"
        },
        {
          "type": "SYMBOL",
          "name": "gte"
        },
        {
          "type": "SYMBOL",
          "name": "lte"
        },
        {
          "type": "SYMBOL",
          "name": "and"
        },
        {
          "type": "SYMBOL",
          "name": "or"
        },
        {
          "type": "SYMBOL",
          "name": "not"
        },
        {
          "type": "SYMBOL",
          "name": "print"
        }
      ]
    },
    "local_bind": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ">$"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "local_var": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "if": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "if"
          },
          {
            "type": "SYMBOL",
            "name": "expression"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "else"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "expression"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "int"
        },
        {
          "type": "SYMBOL",
          "name": "grouping"
        },
        {
          "type": "SYMBOL",
          "name": "builtin"
        },
        {
          "type": "SYMBOL",
          "name": "local_bind"
        },
        {
          "type": "SYMBOL",
          "name": "local_var"
        },
        {
          "type": "SYMBOL",
          "name": "if"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "manual_signature": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "signature"
        }
      ]
    },
    "doc_signature": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "?"
        },
        {
          "type": "SYMBOL",
          "name": "signature"
        }
      ]
    },
    "signature": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "type"
          }
        },
        {
          "type": "STRING",
          "value": "->"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "type"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "Int"
        },
        {
          "type": "STRING",
          "value": "Char"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}