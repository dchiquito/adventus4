{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "adventus",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "def"
      }
    },
    "def": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "def"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "positive_int": {
      "type": "PATTERN",
      "value": "[1-9][0-9_]*"
    },
    "negative_int": {
      "type": "PATTERN",
      "value": "-[1-9][0-9_]*"
    },
    "int": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "positive_int"
        },
        {
          "type": "SYMBOL",
          "name": "negative_int"
        }
      ]
    },
    "grouping": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "expression"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "add": {
      "type": "STRING",
      "value": "+"
    },
    "sub": {
      "type": "STRING",
      "value": "-"
    },
    "mul": {
      "type": "STRING",
      "value": "*"
    },
    "div": {
      "type": "STRING",
      "value": "/"
    },
    "print": {
      "type": "STRING",
      "value": "print"
    },
    "builtin": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "add"
        },
        {
          "type": "SYMBOL",
          "name": "sub"
        },
        {
          "type": "SYMBOL",
          "name": "mul"
        },
        {
          "type": "SYMBOL",
          "name": "div"
        },
        {
          "type": "SYMBOL",
          "name": "print"
        }
      ]
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "int"
        },
        {
          "type": "SYMBOL",
          "name": "grouping"
        },
        {
          "type": "SYMBOL",
          "name": "builtin"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}