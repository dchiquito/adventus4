{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "adventus",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "def"
      }
    },
    "keyword_def": {
      "type": "STRING",
      "value": "def"
    },
    "keyword_if": {
      "type": "STRING",
      "value": "if"
    },
    "keyword_else": {
      "type": "STRING",
      "value": "else"
    },
    "keyword_loop": {
      "type": "STRING",
      "value": "loop"
    },
    "keyword_break": {
      "type": "STRING",
      "value": "break"
    },
    "keyword_malloc": {
      "type": "STRING",
      "value": "malloc"
    },
    "symbol_lbracket": {
      "type": "STRING",
      "value": "["
    },
    "symbol_rbracket": {
      "type": "STRING",
      "value": "]"
    },
    "symbol_lparen": {
      "type": "STRING",
      "value": "("
    },
    "symbol_rparen": {
      "type": "STRING",
      "value": ")"
    },
    "symbol_lbrace": {
      "type": "STRING",
      "value": "{"
    },
    "symbol_rbrace": {
      "type": "STRING",
      "value": "}"
    },
    "symbol_arrow": {
      "type": "STRING",
      "value": "->"
    },
    "def": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword_def"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "closure_var"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "manual_signature"
                },
                {
                  "type": "SYMBOL",
                  "name": "doc_signature"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "positive_int": {
      "type": "PATTERN",
      "value": "[0-9_]+"
    },
    "negative_int": {
      "type": "PATTERN",
      "value": "-[0-9_]+"
    },
    "int": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "positive_int"
        },
        {
          "type": "SYMBOL",
          "name": "negative_int"
        }
      ]
    },
    "character": {
      "type": "PATTERN",
      "value": "'(\\\\[nt\\\\]|[^\\n\\t\\\\])'"
    },
    "grouping": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "symbol_lbracket"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "expression"
          }
        },
        {
          "type": "SYMBOL",
          "name": "symbol_rbracket"
        }
      ]
    },
    "object": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "symbol_lbrace"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "SYMBOL",
          "name": "symbol_rbrace"
        }
      ]
    },
    "type_constraint": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "symbol_lparen"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "symbol_rparen"
        }
      ]
    },
    "add": {
      "type": "STRING",
      "value": "+"
    },
    "sub": {
      "type": "STRING",
      "value": "-"
    },
    "mul": {
      "type": "STRING",
      "value": "*"
    },
    "div": {
      "type": "STRING",
      "value": "/"
    },
    "eq": {
      "type": "STRING",
      "value": "=="
    },
    "ne": {
      "type": "STRING",
      "value": "!="
    },
    "gt": {
      "type": "STRING",
      "value": ">"
    },
    "lt": {
      "type": "STRING",
      "value": "<"
    },
    "gte": {
      "type": "STRING",
      "value": ">="
    },
    "lte": {
      "type": "STRING",
      "value": "<="
    },
    "malloc": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "type_constraint"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_malloc"
        }
      ]
    },
    "builtin": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "add"
        },
        {
          "type": "SYMBOL",
          "name": "sub"
        },
        {
          "type": "SYMBOL",
          "name": "mul"
        },
        {
          "type": "SYMBOL",
          "name": "div"
        },
        {
          "type": "SYMBOL",
          "name": "eq"
        },
        {
          "type": "SYMBOL",
          "name": "ne"
        },
        {
          "type": "SYMBOL",
          "name": "gt"
        },
        {
          "type": "SYMBOL",
          "name": "lt"
        },
        {
          "type": "SYMBOL",
          "name": "gte"
        },
        {
          "type": "SYMBOL",
          "name": "lte"
        },
        {
          "type": "SYMBOL",
          "name": "malloc"
        }
      ]
    },
    "local_bind": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ">$"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "local_var": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "prop_bind": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ">."
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "prop_var": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "closure_var": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "if": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "keyword_if"
          },
          {
            "type": "SYMBOL",
            "name": "expression"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "keyword_else"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "expression"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "loop": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "keyword_loop"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "int"
        },
        {
          "type": "SYMBOL",
          "name": "character"
        },
        {
          "type": "SYMBOL",
          "name": "grouping"
        },
        {
          "type": "SYMBOL",
          "name": "object"
        },
        {
          "type": "SYMBOL",
          "name": "builtin"
        },
        {
          "type": "SYMBOL",
          "name": "local_bind"
        },
        {
          "type": "SYMBOL",
          "name": "local_var"
        },
        {
          "type": "SYMBOL",
          "name": "prop_bind"
        },
        {
          "type": "SYMBOL",
          "name": "prop_var"
        },
        {
          "type": "SYMBOL",
          "name": "closure_var"
        },
        {
          "type": "SYMBOL",
          "name": "if"
        },
        {
          "type": "SYMBOL",
          "name": "loop"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "manual_signature": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "signature"
        }
      ]
    },
    "doc_signature": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "?"
        },
        {
          "type": "SYMBOL",
          "name": "signature"
        }
      ]
    },
    "signature": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "symbol_lparen"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "type"
          }
        },
        {
          "type": "SYMBOL",
          "name": "symbol_arrow"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "type"
          }
        },
        {
          "type": "SYMBOL",
          "name": "symbol_rparen"
        }
      ]
    },
    "builtin_type_type": {
      "type": "STRING",
      "value": "Type"
    },
    "builtin_type_int": {
      "type": "STRING",
      "value": "Int"
    },
    "builtin_type_char": {
      "type": "STRING",
      "value": "Char"
    },
    "builtin_type_bool": {
      "type": "STRING",
      "value": "Bool"
    },
    "builtin_type_none": {
      "type": "STRING",
      "value": "None"
    },
    "builtin_type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "builtin_type_type"
        },
        {
          "type": "SYMBOL",
          "name": "builtin_type_int"
        },
        {
          "type": "SYMBOL",
          "name": "builtin_type_char"
        },
        {
          "type": "SYMBOL",
          "name": "builtin_type_bool"
        },
        {
          "type": "SYMBOL",
          "name": "builtin_type_none"
        }
      ]
    },
    "type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "builtin_type"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "code_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": ".*"
            }
          }
        }
      ]
    },
    "doc_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "//"
        },
        {
          "type": "IMMEDIATE_TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": ".*"
            }
          }
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "code_comment"
    },
    {
      "type": "SYMBOL",
      "name": "doc_comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}