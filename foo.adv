
def LinkList {value next}
def new_list [
  -1
  (LinkList) malloc
]

def ll_len [
  .next
  dup -1 == if [
    pop
    1
  ] else [
    ll_len
    1 +
  ]
]
def ll_append [
  >$value
  >$node
  $node.next -1 == if [
    $value new_list $node>.next
  ] else [
    $node.next $value ll_append
  ]
]



def main [
  11 new_list
  dup 22 ll_append
  dup 33 ll_append
  ll_len
  print
]
