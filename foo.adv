
def LinkList {value next}
def new_list [
  9999
  (LinkList) malloc
]
def ll_len [
  (LinkList) with [
    @next 9999 == if [
      1
    ] else [
      @next ll_len
      1 +
    ]
  ]
]
def ll_append [
  >$value
  (LinkList) with [
    @next 9999 == if [
      $value new_list >@next
    ] else [
      @next $value ll_append
    ]
  ]
]



def main [
  11 new_list
  dup 22 ll_append
  dup 33 ll_append
  ll_len
  print
]
