def range @body [
  >$end
  loop [
    dup $end >= if break
    dup @body // Body must consume the loop variable
    1 +
  ]
  pop
]

def range_loop [
  0 10 range [
    print
    pop
  ]
]

def do_bar @b [
  222 >$i
  @b
]

def do_foo [
  111 >$i
  do_bar [$i print pop]
]

def big_bug [
  do_foo
]

def main [
  #manual_loop_stack
  #manual_loop_var
  range_loop
  big_bug
]
